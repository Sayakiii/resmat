{{> header}}
<h1>Connexion</h1>
{{#erreur}}<div class="erreur">Adresse e-mail ou mot de passe incorrect.</div>{{/erreur}}
{{#deconnecte}}<div class="succes">Vous avez été déconnecté.</div>{{/deconnecte}}
<form action="/login" method="post">
  <input type="hidden" name="{{_csrf.parameterName}}" value="{{_csrf.token}}">
  <p><label for="username">Adresse e-mail</label><br>
     <input type="email" id="username" name="username" required autofocus></p>
  <p><label for="password">Mot de passe</label><br>
     <input type="password" id="password" name="password" required></p>
  <button class="btn" type="submit">Se connecter</button>
</form>
{{> footer}}
